/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML: không cache, luôn kiểm tra phiên bản mới
/YenHoiMaNuCuocHenTranThe/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# WebP: cache 1 năm (nội dung ít đổi, tên file đã đánh số phiên bản khi cần)
/YenHoiMaNuCuocHenTranThe/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

# PNG/JPG gốc (fallback): cache 30 ngày
/YenHoiMaNuCuocHenTranThe/assets/*.png
  Cache-Control: public, max-age=2592000
/YenHoiMaNuCuocHenTranThe/assets/*.jpg
  Cache-Control: public, max-age=2592000

# SVG: cache 30 ngày
/YenHoiMaNuCuocHenTranThe/assets/*.svg
  Cache-Control: public, max-age=2592000
  Content-Type: image/svg+xml

# CSS và JS: cache ngắn vì tên file có ?v= nhưng vẫn nên kiểm tra lại sớm
/YenHoiMaNuCuocHenTranThe/*.css
  Cache-Control: public, max-age=3600
/YenHoiMaNuCuocHenTranThe/*.js
  Cache-Control: public, max-age=3600
